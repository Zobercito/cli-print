{
  NAME "Trabajos de la cola"
  OPERATION Get-Jobs
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name $user
  ATTR keyword which-jobs $which
  ATTR keyword requested-attributes job-id,job-name,job-state,job-state-reasons,job-originating-user-name,job-k-octets,time-at-creation
  DISPLAY job-id
  DISPLAY job-name
  DISPLAY job-state
  DISPLAY job-state-reasons
  DISPLAY job-originating-user-name
  DISPLAY job-k-octets
  DISPLAY time-at-creation
}
